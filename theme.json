    "styles": {
        "blocks": {
            "core/button": {
                "css": "user-select: none;\ndisplay: flex;\nalign-items: center;\nline-height: 1;\njustify-content: center;\nmin-height: var(--wp--preset--spacing--extra-large);\ntransition: opacity var(--wp--custom--transition-normal); &:hover { opacity: 0.8; } &:active { opacity: 0.6 }"
            },
            "core/column": {
                "spacing": {
                    "blockGap": "0px",
                    "padding": {
                        "bottom": "0px",
                        "left": "0px",
                        "right": "0px",
                        "top": "0px"
                    }
                }
            },
            "core/columns": {
                "border": {
                    "radius": "var(--wp--preset--border-radius--extra-large)"
                },
                "css": "overflow: hidden;\n",
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--medium)",
                    "padding": {
                        "bottom": "0px",
                        "left": "0px",
                        "right": "0px",
                        "top": "0px"
                    }
                }
            },
            "core/group": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--medium)",
                    "padding": {
                        "bottom": "0px",
                        "left": "0px",
                        "right": "0px",
                        "top": "0px"
                    }
                }
            },
            "core/image": {
                "border": {
                    "radius": "var(--wp--preset--border-radius--large)"
                }
            },
            "core/post-excerpt": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--body-large)"
                }
            },
            "core/post-featured-image": {
                "border": {
                    "radius": "var(--wp--preset--border-radius--large)"
                }
            },
            "core/post-template": {
                "border": {
                    "radius": "var(--wp--preset--border-radius--extra-large)"
                },
                "css": "overflow: hidden;\n",
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--medium)",
                    "padding": {
                        "bottom": "0px",
                        "left": "0px",
                        "right": "0px",
                        "top": "0px"
                    }
                }
            },
            "core/post-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--headline-large)"
                }
            }
        },
        "color": {
            "background": "var(--wp--preset--color--surface)",
            "text": "var(--wp--preset--color--on-surface)"
        },
        "elements": {
            "button": {
                "border": {
                    "radius": "var(--wp--preset--border-radius--large)"
                },
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--on-primary)"
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--large)",
                        "right": "var(--wp--preset--spacing--large)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--label-large)"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display-large)",
                    "fontWeight": "700"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display-medium)",
                    "fontWeight": "700"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display-small)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--headline-large)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--headline-medium)"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--headline-small)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--on-surface)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "400",
                    "lineHeight": "1.225"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                }
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--text)",
            "fontSize": "var(--wp--preset--font-size--body-medium)",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "1.2"
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
