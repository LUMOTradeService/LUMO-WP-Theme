    "styles": {
        "color": {
            "text": "var:preset|color|on-surface",
            "background": "var:preset|color|surface"
        },
        "elements": {
            "heading": {
                "color": {
                    "text": "var:preset|color|on-surface"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|heading",
                    "fontWeight": "400",
                    "lineHeight": "1.225"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|display-large",
                    "fontWeight": "700"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|display-medium",
                    "fontWeight": "700"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|display-small"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|headline-large"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|headline-medium"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|headline-small"
                }
            },
            "link": {
                "color": {
                    "text": "var:preset|color|secondary"
                }
            },
            "button": {
                ":hover": {
                    "color": {
                        "text": "var:preset|color|on-primary",
                        "background": "var:preset|color|primary"
                    }
                },
                "color": {
                    "text": "var:preset|color|on-primary",
                    "background": "var:preset|color|primary"
                },
                "border": {
                    "radius": "var:preset|border-radius|large"
                },
                "spacing": {
                    "padding": {
                        "left": "var:preset|spacing|large",
                        "right": "var:preset|spacing|large"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|label-large"
                }
            }
        },
        "blocks": {
            "core/button": {
                "css": "display: flex;\nalign-items: center; justify-content: center;\nmin-height: var(--wp--preset--spacing--extra-large);\ntransition: background var(--wp--custom--transition-normal);"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--text)",
            "fontSize": "var(--wp--preset--font-size--body-medium)",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "2.0"
        }
    },
    "customTemplates": {},
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
