{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Tertiary small",
	"slug": "button-tertiary-small",
	"blockTypes": ["core/button"],
	"styles": {
        "color": {
			"text": "var(--wp--preset--color--on-tertiary)",
            "background": "var(--wp--preset--color--tertiary)"
        },
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--large-increased)",
				"right": "var(--wp--preset--spacing--large-increased)",
				"top": "var(--wp--preset--spacing--small)",
				"bottom": "var(--wp--preset--spacing--small)"
			}
		},
		"css": "position: relative; min-height: var(--wp--custom--small-height); &::after {\nposition:absolute;\ncontent: '';\nwidth: 100%;\nmin-height: var(--wp--custom--normal-height);\n}"
	}
}
