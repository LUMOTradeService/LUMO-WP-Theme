{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lumopos/icons",
	"version": "1.0.0",
	"title": "Icons",
	"category": "design",
	"icon": "nametag",
	"description": "Show icons on your website.",
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"iconName": {
			"type": "string",
			"default": "check"
		},
		"customIconUrl": {
			"type": "string",
			"default": ""
		},
		"customIconId": {
			"type": "number"
		},
		"useCustomIcon": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "icons",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}