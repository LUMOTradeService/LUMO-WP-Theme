		"css": ":root {\n    --wpforms-label-error-color: var(--wp--preset--color--error);\n}\n\ntextarea {\n    padding: 14px 0px;\n}\n\ninput[type=\"checkbox\"] {\n    appearance: none;\n    background-color: transparent;\n    margin: 0px !important;\n    font: inherit;\n    color: var(--wp--preset--color--on-surface-variant);\n    width: 20px;\n    height: 20px;\n    border: 2px solid var(--wp--preset--color--on-surface-variant);\n    border-radius: var(--wp--preset--border-radius--extra-small);\n    transform: translateY(2.5px);\n\n    display: grid;\n    place-content: center;\n    cursor: pointer;\n}\n\ninput[type=\"checkbox\"]:checked {\n    border-color: var(--wp--preset--color--primary);\n    color: var(--wp--preset--color--on-primary);\n    background-color: var(--wp--preset--color--primary);\n}\n\nform,\n.wpforms-field-container {\n    display: flex;\n    flex-direction: column;\n    gap: var(--wp--preset--spacing--large);\n}\n\n.comment-form,\n.wpforms-container .wpforms-field {\n    padding: 0px !important;\n\n    &.wpforms-field-gdpr-checkbox {\n        ul {\n            list-style-type: none;\n            padding: 0px;\n\n            li {\n                label {\n                    line-height: 1;\n                    font-size: var(--wp--preset--font-size--label-large) !important;\n                }\n            }\n        }\n    }\n\n    label,\n    legend {\n        padding: 0px var(--wp--preset--spacing--normal) !important;\n        font-size: var(--wp--preset--font-size--label-medium) !important;\n        color: var(--wp--preset--color--on-surface-variant) !important;\n        margin: var(--wp--preset--spacing--extra-small) 0px;\n    }\n}\n\n.wpforms-container label.wpforms-error,\n.wpforms-container em.wpforms-error {\n    color: var(--wp--preset--color--error) !important;\n    font-size: var(--wp--preset--font-size--label-medium) !important;\n    padding-inline: var(--wp--preset--spacing--normal) !important;\n    padding-top: var(--wp--preset--spacing--extra-small) !important;\n}\n\n.wpforms-container .wpforms-field input.wpforms-error,\n.wpforms-container .wpforms-field input.user-invalid,\n.wpforms-container .wpforms-field textarea.wpforms-error,\n.wpforms-container .wpforms-field textarea.user-invalid,\n.wpforms-container .wpforms-field select.wpforms-error,\n.wpforms-container .wpforms-field select.user-invalid {\n    border: 2px solid var(--wp--preset--color--error) !important;\n}\n\n.wpforms-submit {\n    color: var(--wp--preset--color--on-primary);\n    background-color: var(--wp--preset--color--primary);\n    font-size: var(--wp--preset--font-size--label-large) !important;\n    font-weight: normal !important;\n    font-family: inherit;\n    min-height: 48px !important;\n    width: 100% !important;\n    border: none;\n    border-radius: var(--wp--preset--border-radius--large);\n    transition: opacity var(--wp--custom--transition-normal);\n\n    &:hover {\n        opacity: 0.8;\n    }\n\n    &:active {\n        opacity: 0.6;\n    }\n}\n\n@media (max-width: 1200px) {\n    header {\n        .wp-block-site-logo {\n            position: absolute;\n            left: 50%;\n            transform: translateX(-50%);\n        }\n    }\n\n    /*.wp-block-navigation {\n        &:not(.is-responsive) {\n            position: absolute;\n            visibility: hidden;\n        }\n    }*/\n}\n\n@media (min-width: 1201px) {\n    .wp-block-navigation {\n        &:has(.always-shown) {\n            position: absolute;\n            visibility: hidden;\n        }\n    }\n}\n\n@media (min-width: 840px) and (max-width: 1200px) {\n    .wp-block-group.is-layout-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n}\n\n@media (max-width: 839px) {\n    header {\n        .wp-block-buttons {\n            visibility: hidden;\n        }\n    }\n    .wp-block-group.is-layout-grid {\n        display: flex;\n        flex-direction: column;\n    }\n}",
