{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Secondary small selected",
	"slug": "button-secondary-small-selected",
	"blockTypes": ["core/button"],
	"styles": {
        "color": {
			"text": "var(--wp--preset--color--on-secondary-container)",
            "background": "var(--wp--preset--color--secondary-container)"
        },
		"css": "position: relative; min-height: var(--wp--custom--small-height); &::after {\nposition:absolute;\ncontent: '';\nwidth: 100%;\nmin-height: 48px;\n}"
	}
}
